# 复制成 .env 就能直接跑：
#   cp .env.example .env
#
# .env 已经被 git 忽略，不会提交；这个 .example 文件是提交的。
# 真实环境变量的优先级高于 .env，所以线上直接 export 即可。

# 必填：模型服务的 token
LLM_TOKEN=sk-xxx

# 可选：模型名（默认 gpt-4o-mini）
LLM_MODEL=gpt-4o-mini

# 可选：base URL，留空则用库的默认端点
LLM_BASE_URL=https://api.openai.com/v1

# 可选：合并记忆那一次调用的模型（默认跟 LLM_MODEL 一样）
# 合并是独立的一次模型调用，所以可以换成更便宜的小模型
# MERGE_MODEL=gpt-4o-mini

# 可选：记忆库文件（默认当前目录的 memories.db，SQLite）
# MEMORY_DB=memories.db

# 可选：监听地址（默认 :8080）
# LISTEN_ADDR=:8080

# 可选：上下文窗口，用来演示上下文压缩
# MAX_CONTEXT_TOKENS=128000
